{
  "compilerOptions": {
    "checkJs": true,
    "customConditions": ["development"],
    "declarationMap": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "preserve",
    "lib": ["es2023"],
    "module": "node16",
    // Build errors with `lru-cache`.
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023"
  },
  "exclude": ["coverage/", "node_modules/"],
  "include": ["**/*.jsx", "**/*.js", "generate/types.d.ts"]
}
